#!/bin/bash

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Please run: source ./setup"
    return 1 2>/dev/null || exit 1
fi

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$PROJECT_ROOT/venv"
REQUIREMENTS_FILE="${CACTUS_REQUIREMENTS:-$PROJECT_ROOT/python/requirements.txt}"
PARENT_REQUIREMENTS="$PROJECT_ROOT/../requirements.txt"
PYTHON_VERSION="${CACTUS_PYTHON_VERSION:-3.12}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo "Setting up Cactus development environment..."
echo "============================================="
echo ""

echo -e "${BLUE}Step 1: Configuring git hooks for DCO...${NC}"
if git config core.hooksPath .githooks; then
    echo -e "${GREEN}✓ Git hooks configured${NC}"
else
    echo -e "${YELLOW}Warning: failed to configure git hooks${NC}"
fi

name=$(git config user.name || true)
email=$(git config user.email || true)

if [ -z "$name" ] || [ -z "$email" ]; then
    echo ""
    echo -e "${YELLOW}⚠️  Warning: Git user configuration is incomplete${NC}"
    echo ""
    echo "Please configure your git identity:"
    echo "  git config --global user.name \"Your Name\""
    echo "  git config --global user.email \"your.email@example.com\""
    echo ""
else
    echo -e "${GREEN}✓ Git user: $name <$email>${NC}"
fi

echo ""
echo -e "${BLUE}Step 2: Setting up Python virtual environment with uv...${NC}"

if ! command -v uv &> /dev/null; then
    echo -e "${RED}Error: uv is not installed${NC}"
    echo ""
    echo "Please install uv:"
    echo "  macOS:         brew install uv"
    echo "  Ubuntu/Debian: curl -LsSf https://astral.sh/uv/install.sh | sh"
    return 1
fi

if [ ! -d "$VENV_DIR" ]; then
    if ! uv venv --python "$PYTHON_VERSION" "$VENV_DIR" >/dev/null; then
        echo -e "${RED}Failed to create virtual environment${NC}"
        echo "uv can usually provision Python automatically, but if that fails try:"
        echo "  macOS:         brew install python@3.12"
        echo "  Ubuntu/Debian: sudo apt-get install python3.12"
        return 1
    fi
    echo -e "${GREEN}✓ Virtual environment created${NC}"
else
    echo -e "${GREEN}✓ Virtual environment already exists${NC}"
fi

source "$VENV_DIR/bin/activate"

echo ""
echo -e "${BLUE}Step 3: Installing Python dependencies...${NC}"

if [ -f "$REQUIREMENTS_FILE" ]; then
    if uv pip install --python "$VIRTUAL_ENV/bin/python" -r "$REQUIREMENTS_FILE" --quiet; then
        echo -e "${GREEN}✓ Dependencies installed${NC}"
    else
        echo -e "${RED}Failed to install dependencies${NC}"
        return 1
    fi
else
    echo -e "${YELLOW}Warning: requirements.txt not found${NC}"
fi

if [ -f "$PARENT_REQUIREMENTS" ] && [ "$PARENT_REQUIREMENTS" != "$REQUIREMENTS_FILE" ]; then
    echo ""
    echo -e "${BLUE}Detected parent repo requirements at: $PARENT_REQUIREMENTS${NC}"
    echo -e "${BLUE}Installing parent repo requirements...${NC}"
    if uv pip install --python "$VIRTUAL_ENV/bin/python" -r "$PARENT_REQUIREMENTS" --quiet; then
        echo -e "${GREEN}✓ Parent repo dependencies installed${NC}"
    else
        echo -e "${YELLOW}Warning: failed to install parent repo requirements${NC}"
    fi
fi

echo ""
echo -e "${BLUE}Step 4: Installing cactus CLI tools...${NC}"

if uv pip install --python "$VIRTUAL_ENV/bin/python" -e "$PROJECT_ROOT/python" --quiet; then
    echo -e "${GREEN}✓ Cactus CLI installed${NC}"
else
    echo -e "${RED}Failed to install cactus CLI${NC}"
    return 1
fi

echo ""
echo -e "${GREEN}=============================================${NC}"
echo -e "${GREEN}Setup complete!${NC}"
echo -e "${GREEN}=============================================${NC}"
echo ""
cactus --help
